{
  "name": "pterodactyl-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing a Pterodactyl Panel game server (Client API) as tools, with belt-and-braces safety guards",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N1jada/pterodactyl-mcp.git"
  },
  "homepage": "https://github.com/N1jada/pterodactyl-mcp#readme",
  "bugs": {
    "url": "https://github.com/N1jada/pterodactyl-mcp/issues"
  },
  "bin": {
    "pterodactyl-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "minimatch": "^10.2.6",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pterodactyl",
    "game-server",
    "minecraft"
  ]
}
