# ---- Required ---------------------------------------------------------------
# Panel base URL, no trailing slash
PTERODACTYL_PANEL_URL=https://panel.example.com
# Client API key: Panel -> Account -> API Credentials. NEVER commit this file's real counterpart.
PTERODACTYL_API_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional ---------------------------------------------------------------
# Server short ID used when a tool call omits `server`
PTERODACTYL_DEFAULT_SERVER=1a2b3c4d

# ---- Guardrails (see README "Guardrails") ----------------------------------------
# When true every mutating tool refuses. Recommended for the day-to-day profile.
PTERODACTYL_READ_ONLY=false
# Comma-separated allowlist of server short IDs. Unset = default server only.
#PTERODACTYL_ALLOWED_SERVERS=1a2b3c4d,abcd1234
# File and backup deletion refuse unless explicitly enabled
PTERODACTYL_ALLOW_DELETE=false
# The `kill` power signal refuses unless explicitly enabled (risks world corruption)
PTERODACTYL_ALLOW_KILL=false
# Comma-separated globs that write/delete tools refuse to touch
#PTERODACTYL_PROTECTED_PATHS=world/**,world_nether/**,world_the_end/**,server.properties,ops.json,whitelist.json,banned-*.json
# Mutating calls allowed per process lifetime
PTERODACTYL_MAX_MUTATIONS=20
# Take a backup before any file write, file delete or kill; abort if it fails
PTERODACTYL_AUTO_BACKUP=true
# Append-only JSONL audit trail of every mutating call (attempted, refused, succeeded)
#PTERODACTYL_AUDIT_LOG=~/.pterodactyl-mcp/audit.jsonl
# Largest file ptero_read_file will return, in bytes (default 524288)
#PTERODACTYL_MAX_READ_BYTES=524288
